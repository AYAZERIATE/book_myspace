{% extends 'base.html.twig' %}

{% block title %}Workspace - Book My Space{% endblock %}

{% block body %}
<style>
    .workspace-page {
        --ivory: #f8f6f1; --paper: #fffdf9; --ink: #22201c; --muted: #706b62;
        --line: #ded8cd; --gold: #a88b57; --serif: Georgia, "Times New Roman", serif;
        background: var(--ivory); color: var(--ink); font-family: "Helvetica Neue", Arial, sans-serif;
        padding: clamp(4.5rem, 9vw, 8rem) 1.5rem clamp(5rem, 9vw, 8.5rem);
    }
    .workspace-page__inner { max-width: 1320px; margin: 0 auto; }

    .workspace-page__intro { max-width: 720px; margin: 0 auto clamp(3rem, 6vw, 5rem); text-align: center; }
    .workspace-page__eyebrow {
        margin: 0 0 1.35rem; color: var(--gold); font-size: .7rem; font-weight: 600;
        letter-spacing: .22em; text-transform: uppercase;
    }
    .workspace-page__title {
        margin: 0; font-family: var(--serif); font-size: clamp(2.6rem, 5.5vw, 4.5rem);
        font-weight: 400; letter-spacing: -.03em; line-height: 1.02;
    }
    .workspace-page__rule { width: 42px; height: 1px; margin: 2rem auto 1.7rem; background: var(--gold); }
    .workspace-page__subtitle { max-width: 620px; margin: 0 auto; color: var(--muted); font-size: 1rem; line-height: 1.8; }

    .workspace-hero {
        position: relative; overflow: hidden; margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
        max-width: 900px; aspect-ratio: 16 / 9; background: #e7e0d4; border-radius: 2px;
    }
    .workspace-hero img { display: block; width: 100%; height: 100%; object-fit: cover; }

    .workspace-features {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 2.5rem;
        max-width: 760px; margin: clamp(2.5rem, 5vw, 3.5rem) auto 0; list-style: none; padding: 0;
    }
    .workspace-features li {
        display: flex; align-items: flex-start; gap: .65rem; color: var(--muted); font-size: .92rem; line-height: 1.6;
    }
    .workspace-features li::before {
        content: ""; flex: 0 0 auto; width: 6px; height: 6px; margin-top: .55rem;
        background: var(--gold); border-radius: 50%;
    }
    .workspace-discount {
        display: inline-flex; align-items: center; gap: .6rem; margin: clamp(2rem, 4vw, 2.75rem) auto 0;
        padding: .6rem 1.4rem; border: 1px solid var(--gold); border-radius: 2px;
        font-size: .82rem; letter-spacing: .04em; color: var(--ink);
    }
    .workspace-discount strong { font-family: var(--serif); font-size: 1.1rem; color: var(--gold); }

    .offer-carousel-section { margin-top: clamp(4rem, 8vw, 6rem); }
    .offer-carousel-section__title {
        margin: 0 0 clamp(1.75rem, 3vw, 2.5rem); font-family: var(--serif); font-size: clamp(1.6rem, 2.6vw, 2.1rem);
        font-weight: 400; text-align: center;
    }

    .offer-carousel { position: relative; }
    .offer-carousel__track {
        display: flex; gap: clamp(1.5rem, 2.8vw, 2.5rem); overflow-x: auto; scroll-snap-type: x mandatory;
        padding-bottom: .5rem; scrollbar-width: none;
    }
    .offer-carousel__track::-webkit-scrollbar { display: none; }

    .offer-card {
        display: flex; flex-direction: column; overflow: hidden; background: var(--paper);
        border: 1px solid var(--line); border-radius: 2px; scroll-snap-align: start;
        flex: 0 0 clamp(260px, 31%, 400px); transition: border-color .5s ease, transform .5s ease;
    }
    .offer-card:hover { border-color: rgba(168, 139, 87, .7); transform: translateY(-3px); }
    .offer-card__image { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: #e7e0d4; }
    .offer-card__image::after {
        position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 65%, rgba(25, 23, 19, .08));
        content: ""; pointer-events: none;
    }
    .offer-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
    .offer-card:hover .offer-card__image img { transform: scale(1.035); }
    .offer-card__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: #9b8d76; }
    .offer-card__placeholder::before { width: 42px; height: 42px; border: 1px solid currentColor; border-radius: 50%; content: ""; }
    .offer-card__content { display: flex; flex: 1; flex-direction: column; padding: clamp(1.4rem, 2.6vw, 1.9rem); }
    .offer-card__marker { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.1rem; color: var(--gold); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
    .offer-card__marker::before { width: 22px; height: 1px; background: currentColor; content: ""; }
    .offer-card__title {
        margin: 0 0 .9rem; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 1.05rem;
        font-weight: 700; letter-spacing: .01em; line-height: 1.3; text-transform: uppercase;
    }
    .offer-card__description { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.75; }

    .offer-carousel__controls {
        display: flex; align-items: center; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;
    }
    .offer-carousel__btn {
        display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid var(--line);
        border-radius: 50%; background: var(--paper); color: var(--ink); cursor: pointer;
        transition: border-color .3s ease, background .3s ease;
    }
    .offer-carousel__btn:hover { border-color: var(--gold); background: var(--ivory); }
    .offer-carousel__btn:disabled { opacity: .35; cursor: default; }
    .offer-carousel__btn svg { width: 16px; height: 16px; }
    .offer-carousel__counter { min-width: 2.5rem; text-align: center; color: var(--muted); font-size: .88rem; letter-spacing: .03em; }

    .offers-empty {
        max-width: 520px; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) 1.5rem;
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center;
    }
    .offers-empty__title { margin: 0 0 .85rem; font-family: var(--serif); font-size: 2rem; font-weight: 400; }
    .offers-empty__text { margin: 0; color: var(--muted); line-height: 1.7; }

    @media (max-width: 991.98px) { .offer-card { flex-basis: 46%; } }
    @media (max-width: 640px) {
        .workspace-page { padding-right: 1.1rem; padding-left: 1.1rem; }
        .workspace-features { grid-template-columns: 1fr; }
        .offer-card { flex-basis: 82%; }
    }
    @media (prefers-reduced-motion: reduce) { .offer-card, .offer-card__image img { transition: none; } }
</style>

<main class="workspace-page">
    <div class="workspace-page__inner">

        <header class="workspace-page__intro">
            <p class="workspace-page__eyebrow">Book My Space</p>

            <h1 class="workspace-page__title">Private Workspace Experience</h1>

            <div class="workspace-page__rule" aria-hidden="true"></div>

            <p class="workspace-page__subtitle">
                A quiet, dedicated space designed for focused work, private calls, and uninterrupted deep work sessions.
            </p>

            <div class="workspace-hero">
                <img
                    src="{{ asset('assets/spark/images/offer_4.jpg') }}"
                    alt="Private Workspace Experience"
                    onerror="this.style.display='none';"
                >
            </div>

            <ul class="workspace-features">
                <li>A private, quiet environment away from open-plan distractions</li>
                <li>Ideal for focused work, calls, and deep concentration</li>
                <li>Fully equipped with high-speed connectivity and comfortable seating</li>
                <li>Available for individual or small-team use</li>
            </ul>

            {% if discount_percentage is defined and discount_percentage %}
                <div class="workspace-discount">
                    <span>Enjoy an exclusive</span>
                    <strong>{{ discount_percentage }}%</strong>
                    <span>off your workspace booking</span>
                </div>
            {% endif %}
        </header>

        {% set other_offers = offers is defined
            ? offers|filter(o => o.title != 'Private Workspace Experience')
            : []
        %}

        <section class="offer-carousel-section">
            <h2 class="offer-carousel-section__title">Our Other Offers</h2>

            {% if other_offers|length > 0 %}
                <div class="offer-carousel" aria-label="Other offers" data-carousel>
                    <div class="offer-carousel__track" data-carousel-track>
                        {% for offer in other_offers %}
                            <article class="offer-card">
                                <div class="offer-card__image">
                                    {% if offer.image %}
                                        <img
                                            src="{{ asset('assets/spark/images/' ~ offer.image) }}"
                                            alt="{{ offer.title }}"
                                            loading="lazy"
                                            onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='grid';"
                                        >
                                        <div class="offer-card__placeholder" aria-hidden="true" style="display:none;"></div>
                                    {% else %}
                                        <div class="offer-card__placeholder" aria-hidden="true"></div>
                                    {% endif %}
                                </div>
                                <div class="offer-card__content">
                                    <span class="offer-card__marker">Exclusive offer</span>
                                    <h3 class="offer-card__title">{{ offer.title }}</h3>
                                    <p class="offer-card__description">{{ offer.description }}</p>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                    <div class="offer-carousel__controls">
                        <button type="button" class="offer-carousel__btn" data-carousel-prev aria-label="Previous offer">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 18l-6-6 6-6"/></svg>
                        </button>
                        <span class="offer-carousel__counter"><span data-carousel-current>1</span>/<span data-carousel-total>1</span></span>
                        <button type="button" class="offer-carousel__btn" data-carousel-next aria-label="Next offer">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 18l6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
            {% else %}
                <div class="offers-empty">
                    <h2 class="offers-empty__title">Currently unavailable</h2>
                    <p class="offers-empty__text">Discover our latest workspace experiences soon.</p>
                </div>
            {% endif %}
        </section>

    </div>
</main>

<script>
    document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
        const track = carousel.querySelector('[data-carousel-track]');
        const prevBtn = carousel.querySelector('[data-carousel-prev]');
        const nextBtn = carousel.querySelector('[data-carousel-next]');
        const currentEl = carousel.querySelector('[data-carousel-current]');
        const totalEl = carousel.querySelector('[data-carousel-total]');
        const cards = Array.from(track.children);
        if (!cards.length) return;

        function visibleCount() {
            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);
            return Math.max(1, Math.round(track.clientWidth / (cardWidth + gap)));
        }
        function pageCount() {
            return Math.max(1, Math.ceil(cards.length / visibleCount()));
        }
        function currentPage() {
            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);
            return Math.min(pageCount(), Math.round(track.scrollLeft / (cardWidth + gap) / visibleCount()) + 1);
        }
        function update() {
            const total = pageCount();
            const page = currentPage();
            currentEl.textContent = page;
            totalEl.textContent = total;
            prevBtn.disabled = page <= 1;
            nextBtn.disabled = page >= total;
        }
        function scrollByPage(direction) {
            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);
            track.scrollBy({ left: direction * visibleCount() * (cardWidth + gap), behavior: 'smooth' });
        }

        prevBtn.addEventListener('click', function () { scrollByPage(-1); });
        nextBtn.addEventListener('click', function () { scrollByPage(1); });
        track.addEventListener('scroll', function () { window.requestAnimationFrame(update); });
        window.addEventListener('resize', update);
        update();
    });
</script>
{% endblock %}
