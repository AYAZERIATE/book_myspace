{% extends 'base.html.twig' %}

{% block title %}Book My Space – Exclusive Offers{% endblock %}

{% block body %}
<style>
.offer-card__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
}
    .offers-page {
        --ivory: #f8f6f1; --paper: #fffdf9; --ink: #22201c; --muted: #706b62;
        --line: #ded8cd; --gold: #a88b57; --serif: Georgia, "Times New Roman", serif;
        background: var(--ivory); color: var(--ink); font-family: "Helvetica Neue", Arial, sans-serif;
        padding: clamp(4.5rem, 9vw, 8rem) 1.5rem clamp(5rem, 9vw, 8.5rem);
    }
    .offers-page__inner { max-width: 1320px; margin: 0 auto; }
    .offers-page__intro { max-width: 720px; margin: 0 auto clamp(3.5rem, 7vw, 6rem); text-align: center; }
    .offers-page__eyebrow, .offer-card__marker {
        color: var(--gold); font-size: .7rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    }
    .offers-page__eyebrow { margin: 0 0 1.35rem; }
    .offers-page__title {
        margin: 0; font-family: var(--serif); font-size: clamp(3rem, 6.5vw, 5.5rem);
        font-weight: 400; letter-spacing: -.035em; line-height: .98;
    }
    .offers-page__rule { width: 42px; height: 1px; margin: 2rem auto 1.7rem; background: var(--gold); }
    .offers-page__subtitle { max-width: 500px; margin: 0 auto; color: var(--muted); font-size: 1rem; line-height: 1.8; }
    .offers-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 2.8vw, 2.5rem); }
    .offer-card {
        display: flex; min-width: 0; flex-direction: column; overflow: hidden; background: var(--paper);
        border: 1px solid var(--line); border-radius: 2px; transition: border-color .5s ease, transform .5s ease;
    }
    .offer-card:hover { border-color: rgba(168, 139, 87, .7); transform: translateY(-3px); }
    .offer-card__image { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: #e7e0d4; }
    .offer-card__image::after {
        position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 65%, rgba(25, 23, 19, .08));
        content: ""; pointer-events: none;
    }
    .offer-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
    .offer-card:hover .offer-card__image img { transform: scale(1.035); }
    .offer-card__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: #9b8d76; }
    .offer-card__placeholder::before { width: 42px; height: 42px; border: 1px solid currentColor; border-radius: 50%; content: ""; }
    .offer-card__content { display: flex; flex: 1; flex-direction: column; padding: clamp(1.6rem, 3vw, 2.25rem); }
    .offer-card__marker { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.15rem; font-size: .65rem; letter-spacing: .18em; }
    .offer-card__marker::before { width: 22px; height: 1px; background: currentColor; content: ""; }
    .offer-card__title {
        margin: 0 0 1rem; font-family: var(--serif); font-size: clamp(1.65rem, 2.2vw, 2rem);
        font-weight: 400; letter-spacing: -.02em; line-height: 1.12;
    }
    .offer-card__description { margin: 0; color: var(--muted); font-size: .94rem; line-height: 1.75; }
    .offers-empty {
        grid-column: 1 / -1; max-width: 520px; margin: 0 auto; padding: clamp(3rem, 7vw, 5rem) 1.5rem;
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center;
    }
    .offers-empty__title { margin: 0 0 .85rem; font-family: var(--serif); font-size: 2rem; font-weight: 400; }
    .offers-empty__text { margin: 0; color: var(--muted); line-height: 1.7; }
    @media (max-width: 991.98px) { .offers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 640px) { .offers-page { padding-right: 1.1rem; padding-left: 1.1rem; } .offers-grid { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .offer-card, .offer-card__image img { transition: none; } }
</style>

<main class="offers-page">
    <div class="offers-page__inner">
        <header class="offers-page__intro">
            <p class="offers-page__eyebrow">Book My Space</p>
            <h1 class="offers-page__title">Exclusive Offers</h1>
            <div class="offers-page__rule" aria-hidden="true"></div>
            <p class="offers-page__subtitle">Curated experiences designed to make your workspace more exceptional.</p>
        </header>

        <section class="offers-grid" aria-label="Exclusive offers">
            {% for offer in offers %}
                {% set offer_route = offer.title == 'Double Your Productivity'
                    ? 'app_productivity'
                    : (offer.title == 'Team Together'
                        ? 'app_team'
                        : (offer.title == 'Premium Business Escape'
                            ? 'app_business'
                            : (offer.title == 'Private Workspace Experience'
                                ? 'app_workspace'
                                : (offer.title == 'Full Day, Full Focus'
                                    ? 'app_fullday'
                                    : (offer.title == 'Extend Your Focus' ? 'app_focus' : null)))))
                %}
                <article class="offer-card">
                    {% if offer_route %}<a href="{{ path(offer_route) }}" class="offer-card__link">{% endif %}
                    <div class="offer-card__image">
                        {% if offer.image %}
                            <img src="{{ asset('assets/spark/images/' ~ offer.image) }}" alt="{{ offer.title }}">
                        {% else %}
                            <div class="offer-card__placeholder" aria-hidden="true"></div>
                        {% endif %}
                    </div>
                    <div class="offer-card__content">
                        <span class="offer-card__marker">Exclusive offer</span>
                        <h2 class="offer-card__title">{{ offer.title }}</h2>
                        <p class="offer-card__description">{{ offer.description }}</p>
                    </div>
                    {% if offer_route %}</a>{% endif %}
                </article>
            {% else %}
                <div class="offers-empty">
                    <h2 class="offers-empty__title">Currently unavailable</h2>
                    <p class="offers-empty__text">Discover our latest workspace experiences soon.</p>
                </div>
            {% endfor %}
        </section>
    </div>
</main>
{% endblock %}
